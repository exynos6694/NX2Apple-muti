diff --git a/dm/host/pad_joycon.h b/dm/host/pad_joycon.h
index 055da08..41e80fb 100644
--- a/dm/host/pad_joycon.h
+++ b/dm/host/pad_joycon.h
@@ -18,6 +18,32 @@
 #define JOYCON_REPORT_0x30     0x30
 #define JOYCON_REPORT_MIN_LEN  12
 #define JOYCON_STICK_CENTER    2048
+
+// HD rumble for one Joy-Con's actuator, as the output reports 0x01 and 0x10 carry it (4 bytes; dekuNukem's Nintendo_Switch_Reverse_Engineering,
+// SDL's hidapi Switch driver): the high band's frequency (9 bits) and amplitude, the low band's frequency and amplitude (9 bits). The amplitude
+// code is the reverse-engineered curve, 100 (0xc8 in the high band) at 1.0; frequencies are clamped to what each band encodes. Silence is the
+// neutral 00 01 40 40, which the existing reports send.
+static inline int joycon_rumble_amp_code(float a) {
+    if (!(a > 0)) return 0;
+    if (a > 1) a = 1;
+    float e = a > 0.23f ? log2f(a * 8.7f) * 32.f : a > 0.12f ? log2f(a * 17.f) * 16.f : a / 0.12f * 16.f;
+    int c = (int)lroundf(e);
+    return c < 1 ? 1 : c > 100 ? 100 : c;
+}
+static inline void joycon_rumble_bytes(float amp_low, float freq_low, float amp_high, float freq_high, uint8_t out[4]) {
+    int hc = joycon_rumble_amp_code(amp_high), lc = joycon_rumble_amp_code(amp_low);
+    if (!hc && !lc) { out[0] = 0x00; out[1] = 0x01; out[2] = 0x40; out[3] = 0x40; return; }
+    float fh = freq_high > 0 ? fminf(fmaxf(freq_high, 81.75f), 1252.f) : 320.f;
+    float fl = freq_low > 0 ? fminf(fmaxf(freq_low, 40.875f), 626.f) : 160.f;
+    int hf = ((int)lroundf(log2f(fh / 10.f) * 32.f) - 0x60) * 4, lf = (int)lroundf(log2f(fl / 10.f) * 32.f) - 0x40;
+    hf = hf < 0 ? 0 : hf > 0x1fc ? 0x1fc : hf;
+    lf = lf < 1 ? 1 : lf > 0x7f ? 0x7f : lf;
+    unsigned lamp = (0x40u + (unsigned)(lc >> 1)) | ((unsigned)(lc & 1) << 15);
+    out[0] = (uint8_t)(hf & 0xff);
+    out[1] = (uint8_t)((hc * 2) | ((hf >> 8) & 1));
+    out[2] = (uint8_t)(lf | ((lamp >> 8) & 0x80));
+    out[3] = (uint8_t)(lamp & 0xff);
+}
 #define JOYCON_STICK_RADIUS    1400.0f
 #define JOYCON_STICK_DZ        0.12f
 
