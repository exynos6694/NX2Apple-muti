From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: exynos6694 <azsx6694@naver.com>
Date: Tue, 10 Nov 2026 20:45:28 +0900
Subject: [PATCH] Vibration handles for an npad's style whether or not a
 controller is there now

Horizon computes vibration handles from the npad id and the style alone. Rhythm Heaven Groove asks
once, at start-up, for every npad's handles while only player 1 is connected, and never again; the
host answered none for the empty npads, so a player who connected later (a Joy-Con 2 split off with
SL + SR, a Pro Controller) never felt rumble, and half of every vibration batch went nowhere.

GetVibrationDeviceHandles now hands out the handles of the style asked for on No1..No8 (and
Handheld's own) when the npad's controller has another style or none; each send is still routed by
what the npad holds then (vib_players), so a full-key handle reaches a Pro Controller, a pair or a
single Joy-Con of its side. GetVibrationDeviceInfo answers from the handle, as Horizon does;
IsVibrationDeviceMounted still follows the connected controller.

Upstream-Status: pending
Reason: Rumble for players who connect after a game asked for vibration handles (Rhythm Heaven Groove's split Joy-Cons)
Issue: none yet (exynos6694/NX2Apple-muti feature/local-wireless)

---
 dm/host/hle_hid.c     | 39 ++++++++++++++++++++++++++++++++-------
 dm/host/tests/t_hid.c | 18 ++++++++++++++++--
 2 files changed, 48 insertions(+), 9 deletions(-)

diff --git a/dm/host/hle_hid.c b/dm/host/hle_hid.c
index d08aa55..bf78a06 100644
--- a/dm/host/hle_hid.c
+++ b/dm/host/hle_hid.c
@@ -1098,20 +1098,45 @@ HLE_FORCE("_ZN2nn3hid6system15PermitVibrationEb", "system permit vibration: cont
 // Games can cache handles once at startup, before GameController routes the pad's haptics (Unicorn Overlord kept an empty answer and sent every value to handle 0).
 // On Horizon handles are computed from npad id and style (libnx _hidGetVibrationDeviceHandles); vib_send checks for an output at each send. With rumble off they are handed out too,
 // as on a Switch whose vibration setting is off (IsVibrationPermitted answers false and nothing is felt), so turning it on while the game runs works in a game that asked only once.
-HLE_FORCE("_ZN2nn3hid25GetVibrationDeviceHandlesEPNS0_21VibrationDeviceHandleEiRKjNS_4util10BitFlagSetILi32ENS0_12NpadStyleTagEEE", "vibration devices of the connected controller",
+// A style the npad's controller does not have now gets the handles of that style too, as Horizon computes them: a game that asks once at start-up for every npad (Rhythm Heaven
+// Groove, while only player 1 is connected) then reaches the players that connect later. vib_players routes each send by what the npad holds then, and a full-key handle
+// reaches a Pro Controller and single or paired Joy-Cons alike.
+static uint32_t vib_style_type(uint32_t id, uint32_t style) {   // 0: no such style on that npad
+    if (id == NPAD_HANDHELD) return style & STYLE_HANDHELD ? 4u : 0u;
+    if (id >= DM_PLAYERS) return 0;
+    if (style & STYLE_FULLKEY) return 3;
+    if (style & (STYLE_JOYDUAL | STYLE_JOYDUAL2)) return 5;
+    if (style & (STYLE_JOYLEFT | STYLE_JOYLEFT2)) return 6;
+    if (style & (STYLE_JOYRIGHT | STYLE_JOYRIGHT2)) return 7;
+    return 0;
+}
+HLE_FORCE("_ZN2nn3hid25GetVibrationDeviceHandlesEPNS0_21VibrationDeviceHandleEiRKjNS_4util10BitFlagSetILi32ENS0_12NpadStyleTagEEE", "vibration devices of the npad's style",
           int, h_hid_VibHandles, uint32_t *h, int n, const uint32_t *id, uint32_t style) {
-    if (!h || !id || n <= 0 || !(style & style_of(*id)) || !dm_haptics_has_output()) {
+    uint32_t type = 0;
+    if (h && id && n > 0 && dm_haptics_has_output()) {
+        if (style & style_of(*id)) {   // the connected controller's own style
+            npad_ref r = npad_resolve(*id);
+            type = r.kind == KIND_DUAL ? 5u : r.kind == KIND_LEFT ? 6u : r.kind == KIND_RIGHT ? 7u : *id == NPAD_HANDHELD ? 4u : 3u;
+        } else type = vib_style_type(*id, style);
+    }
+    if (!type) {
         if (getenv("DM_RUMBLE_LOG") && id) LOG("rumble: game asked for vibration handles of npad %u style %#x: none (connected style %#x, %s)", *id, style, style_of(*id), dm_haptics_has_output() ? "output ready" : "no output yet");
         return 0;
     }
-    npad_ref r = npad_resolve(*id);
-    uint32_t type = r.kind == KIND_DUAL ? 5u : r.kind == KIND_LEFT ? 6u : r.kind == KIND_RIGHT ? 7u : *id == NPAD_HANDHELD ? 4u : 3u;
-    uint32_t base = (*id << 8) | type;
-    int count = n < (r.kind == KIND_LEFT || r.kind == KIND_RIGHT ? 1 : 2) ? n : (r.kind == KIND_LEFT || r.kind == KIND_RIGHT ? 1 : 2);
+    uint32_t base = (*id << 8) | type, one = type == 6 || type == 7;
+    int count = n < (one ? 1 : 2) ? n : (one ? 1 : 2);
     for (int i = 0; i < count; i++) h[i] = base | (uint32_t)i << 16;
     if (getenv("DM_RUMBLE_LOG")) LOG("rumble: game asked for vibration handles of npad %u style %#x: %d, first %#x", *id, style, count, h[0]);
     return count;
 }
+// A handle GetVibrationDeviceHandles hands out, whether or not a controller of its style is on the npad now; *motor: 0 left, 1 right
+static int vib_handle_ok(uint32_t h, int *motor) {
+    unsigned type = h & 0xff, id = h >> 8 & 0xff, dev = h >> 16 & 0xff;
+    static const uint32_t style_by_type[8] = {0, 0, 0, STYLE_FULLKEY, STYLE_HANDHELD, STYLE_JOYDUAL, STYLE_JOYLEFT, STYLE_JOYRIGHT};
+    if (h >> 24 || dev > 1 || type > 7 || !style_by_type[type] || vib_style_type(id, style_by_type[type]) != type || ((type == 6 || type == 7) && dev)) return 0;
+    *motor = type == 6 ? 0 : type == 7 ? 1 : (int)dev;
+    return 1;
+}
 HLE_FORCE("_ZN2nn3hid25InitializeVibrationDeviceERKNS0_21VibrationDeviceHandleE", "vibration: initialize one channel", void, h_hid_InitVib, const uint32_t *h) {
     const dm_vibration idle = {0, 160, 0, 320}; vib_send(h, &idle, 1);
 }
@@ -1243,7 +1268,7 @@ HLE_FORCE("_ZN2nn3hid41IsFirmwareUpdateAvailableForSixAxisSensorERKNS0_19SixAxis
 // GetVibrationDeviceInfo is queried right after GetVibrationDeviceHandles at startup, before a physical controller's
 // haptics route is registered, so it follows handle validity and sink presence rather than active route availability.
 HLE_FORCE("_ZN2nn3hid22GetVibrationDeviceInfoEPNS0_19VibrationDeviceInfoERKNS0_21VibrationDeviceHandleE", "vibration: linear resonant actuator, left or right", void, h_hid_VibInfo, uint32_t *info, const uint32_t *h) {
-    int m = 0, on = h && dm_haptics_has_output() && vib_players(*h, &m) != 0; info[0] = on ? 1 : 0; info[1] = on ? 1 + m : 0;
+    int m = 0, on = h && dm_haptics_has_output() && vib_handle_ok(*h, &m); info[0] = on ? 1 : 0; info[1] = on ? 1 + m : 0;
 }
 // The SDK's own call reaches the hid service (a null read in hid::detail::IsVibrationDeviceMounted; Super Mario Odyssey asks for each handle of a controller).
 // On Horizon a device is mounted when the npad's connected controller has that style and an actuator on that side: here, when the channel has an output, as GetVibrationDeviceInfo reports it
diff --git a/dm/host/tests/t_hid.c b/dm/host/tests/t_hid.c
index cccc08f..266b545 100644
--- a/dm/host/tests/t_hid.c
+++ b/dm/host/tests/t_hid.c
@@ -196,6 +196,12 @@ static void t_joycons(void) {
     CHECK((st.buttons & (DM_BTN_A | DM_BTN_RSR)) == (DM_BTN_A | DM_BTN_RSR) && !(st.buttons & DM_BTN_UP) && st.ry == 15000 && st.attributes == (ATTR_CONNECTED | ATTR_RIGHT_CONN), "the right half on No2: its own buttons and stick only");
     id = 1; CHECK(h_hid_VibHandles(h, 2, &id, STYLE_JOYRIGHT) == 1 && (h[0] & 0xff) == 7, "JoyRight: one vibration handle, type 7");
     { int m; CHECK(vib_targets(h[0], &m) == 1 && m == 1, "it reaches player 1's right motor, on No2"); }
+    { uint32_t lone[2]; int m;   // Rhythm Heaven Groove: full-key handles taken at start-up, before the Joy-Cons, reach a Joy-Con alone on that npad by its side
+    CHECK(h_hid_VibHandles(lone, 2, &(uint32_t){3}, STYLE_JOYRIGHT) == 1 && lone[0] == 0x307, "an empty npad's JoyRight handle: type 7, one motor");
+    dm_pad_players(1u | 1u << 3); dm_haptics_route(3, 1); dm_joy_attach(3, 2);
+    CHECK(vib_targets(0x10303, &m) == 1u << 3 && m == 1 && !vib_targets(0x303, &m), "a right Joy-Con alone takes its npad's right full-key handle, not the left one");
+    CHECK(vib_targets(lone[0], &m) == 1u << 3 && m == 1, "and the JoyRight handle the game took while the npad was empty");
+    dm_joy_attach(3, 0); dm_haptics_route(3, 0); dm_pad_players(1); }
     uint32_t other = 9; CHECK(h_hid_JoySingleOut(&other, &(uint32_t){0}, 0) == 1 && other == 1, "single assignment with the other half: No2");
     h_hid_JoyDual(&(uint32_t){0});
     CHECK(h_hid_GetStyle(&(uint32_t){0}) == STYLE_JOYDUAL && h_hid_GetStyle(&(uint32_t){1}) == 0, "dual again: one JoyDual npad, No2 empty");
@@ -266,7 +272,8 @@ static void t_vibration(void) {
           "startup handles do not wait for a routed haptics output");
     h_hid_VibInfo(info, &h[0]); CHECK(info[0] == 1 && info[1] == 1, "startup left motor reports a left LRA before routing");
     h_hid_VibInfo(info, &h[1]); CHECK(info[0] == 1 && info[1] == 2, "startup right motor reports a right LRA before routing");
-    h_hid_VibInfo(info, &(uint32_t){0x203}); CHECK(info[0] == 0 && info[1] == 0, "disconnected player reports no LRA before routing");
+    h_hid_VibInfo(info, &(uint32_t){0x10203}); CHECK(info[0] == 1 && info[1] == 2, "a disconnected player's handle reports its LRA, as Horizon computes it from the handle");
+    h_hid_VibInfo(info, &(uint32_t){0x204}); CHECK(info[0] == 0 && info[1] == 0, "a handheld handle on a numbered npad reports nothing");
     CHECK(!h_hid_VibMounted(&h[0]), "no routed output: device not mounted");
     h_hid_SendVib(&h[0], &v);
     CHECK(dm_haptics_actual(0, 0).amplitude_low == 0, "a value before routing is not retained");
@@ -276,7 +283,14 @@ static void t_vibration(void) {
     CHECK(h_hid_VibPermit() && h_hid_VibHandles(h, 2, &id, STYLE_FULLKEY) == 2, "two vibration motors available");
     CHECK(h[0] == 3 && h[1] == 0x10003, "SDK vibration handle bytes: style 3, npad 0, motors 0 and 1");
     CHECK(!h_hid_VibHandles(h, 2, &id, STYLE_HANDHELD), "wrong controller style gets no motors");
-    CHECK(!h_hid_VibHandles(h, 2, &(uint32_t){2}, STYLE_FULLKEY), "disconnected player gets no motors");
+    { uint32_t late[2] = {0}; int m;
+    CHECK(h_hid_VibHandles(late, 2, &(uint32_t){2}, STYLE_FULLKEY) == 2 && late[0] == 0x203 && late[1] == 0x10203,
+          "a disconnected player's npad gets the handles of the style asked for, as Horizon computes them (a game may ask only once, at start-up)");
+    CHECK(!vib_targets(late[0], &m) && !h_hid_VibMounted(&late[0]), "they reach nothing and are not mounted while no controller is there");
+    ids((uint32_t[]){0, 1, 2, NPAD_HANDHELD}, 4); dm_pad_players(1u | 1u << 2); dm_haptics_route(2, 1);
+    CHECK(vib_targets(late[1], &m) == 1u << 2 && m == 1 && h_hid_VibMounted(&late[1]), "the start-up handles reach the player who connects later");
+    dm_haptics_route(2, 0); ids((uint32_t[]){0, 1, NPAD_HANDHELD}, 3); dm_pad_players(3); }
+    CHECK(!h_hid_VibHandles(h, 2, &(uint32_t){9}, STYLE_FULLKEY) && !h_hid_VibHandles(h, 2, &id, 0), "no npad past No8, no style: no handles");
     CHECK(h_hid_VibHandles(h, 1, &id, STYLE_FULLKEY) == 1, "handle count respects caller capacity");
     h_hid_SendVib(&h[0], &v); h_hid_VibActual(&got, &h[0]);
     CHECK(!memcmp(&got, &v, sizeof v) && vibration[1].motor[0].amplitude_low == 0, "game value is retained for the addressed player only");
