-    if (leaf && gh >= st[5] * u && gh < 720 * u * st[1] - 2 && fab(g[7]) < 40 * u && draws(pane, fn_null_draw)) {
+    if (d != 0 && leaf && gh >= st[5] * u && gh < 720 * u * st[1] - 2 && fab(g[7]) < 40 * u && draws(pane, fn_null_draw)) {
         g[4] *= st[1]; g[5] *= st[1]; g[6] *= st[1]; g[7] *= st[1];
         return;
     }
@@ -56,6 +60,10 @@ void duo_calc(char *pane, const float *st, const void *fn_null_draw) {
         if (!container(p, fn_null_draw, st, u)) return;   // a widget above: the widget's top is further up
         p = par;
     }
+    // The wider screen: a widget out towards the left or right (|x| st[9] or more, 300 by default: the clock, the minimap, the road and album buttons, the guides at the
+    // corners) moves out by the extra half-width, so the HUD sits at the screen's sides; the middle (dialogue, the title's logo, the press-A line) stays centred
+    if (dx != 0 && fab(g[3]) >= st[9] * u) g[3] += g[3] > 0 ? dx : -dx;
+    if (d == 0) return;
     float *gy = g + 7;
     // In 720 units (x 1.5 in the 1080 space): 230 for a widget towards a corner (|x| 400 or more: the top right's road and album buttons at 420 and 389, the bottom left's
